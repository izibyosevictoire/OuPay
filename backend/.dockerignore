target/
.test-pgdata/
.test-pgdata.pw
backups/
*.dump
scripts/
compose.yaml
Dockerfile
.dockerignore
.git/
.gitignore
.idea/
.vscode/
*.iml
.env
.env.*
*.pem
*.key
*.jks
*.p12
*.log
# Tests and the dev profile are not part of the image (the Dockerfile also removes application-dev.yml).
src/test/

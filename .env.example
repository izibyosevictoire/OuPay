# Frontend modes (see docs/backend.md, "Frontend integration").
#
# Demo mode (default): in-browser mock services, fake data, no backend needed.
# VITE_API_MODE=mock
#
# Server-backed mode: the real OuPay backend. The session is the server's HttpOnly cookie.
# VITE_API_MODE=http
# VITE_API_BASE_URL=/api/v1                       # same origin by default; the dev server proxies /api
# VITE_API_PROXY_TARGET=http://localhost:8080     # where `npm run dev` forwards /api
#
# Optional.
# VITE_PUBLIC_PAYMENT_BASE_URL=https://pay.example.test   # base URL printed in QR codes (illustrative default)
# VITE_ENABLE_DEMO_TOOLS=true                              # demo tools in a production build (mock mode only)

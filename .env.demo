# The separate OuPay DEMO build (R9c): `npm run dev:demo` / `npm run build:demo`. Public flags only, no secrets.
# Mock services in the browser (never the HTTP client), the Kigali Demo Supermarket examples, and the simulated-payment tools.
VITE_API_MODE=mock
VITE_DEMO_EXPERIENCE=true
VITE_ENABLE_DEMO_TOOLS=true
